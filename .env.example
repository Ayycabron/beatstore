# Copie ce fichier en .env et remplis les valeurs.

# Adresse publique du site (sert pour les liens dans les e-mails)
SITE_URL=http://localhost:3000
PORT=3000

# Mot de passe de la page /admin
ADMIN_PASSWORD=change-moi

# Où tu reçois les demandes
PRODUCER_EMAIL=ton-adresse@exemple.com

# Comment on te paie (affiché dans l'e-mail des licences)
PAYMENT_INFO=PayPal ou virement

# --- Envoi d'e-mails (SMTP) ---------------------------------------------
# Gmail : active la validation en 2 étapes puis crée un « mot de passe d'application »
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ton-adresse@gmail.com
SMTP_PASS=mot-de-passe-application
MAIL_FROM="Théo Hamel <ton-adresse@gmail.com>"

# --- Dropbox (optionnel) --------------------------------------------------
# Sans Dropbox, les prods sont lues dans le dossier ./beats et les demandes dans ./data
# Avec Dropbox : lance « npm run dropbox-token » pour obtenir le refresh token.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_BEATS_DIR=/beatstore/prods
DROPBOX_DATA_PATH=/beatstore/data/db.json
